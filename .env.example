# انسخ الملف ده لـ .env.local وعبّي القيم. ماتعملش commit للـ .env.local أبدًا.

# رابط MongoDB (Atlas أو محلي)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/qualx

# سر تشفير الجلسات — إجباري. ولّد واحد بـ:  openssl rand -base64 32
NEXTAUTH_SECRET=

# عنوان الموقع (محليًا: http://localhost:3000 — في الإنتاج: دومينك الحقيقي بـ https)
NEXTAUTH_URL=http://localhost:3000

# اختياري لكن موصى بيه جدًا على Vercel/serverless: Upstash Redis للـ rate limiting.
# من غيره الـ rate limit بيشتغل في ذاكرة كل instance لوحدها (أضعف).
# https://upstash.com  (فيه free tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# اختياري: اكتب false عشان تقفل إنشاء الحسابات الجديدة من الموقع (لو اتعمل عليه سبام).
# أي قيمة تانية (أو تركه فاضي) = التسجيل مفتوح.
REGISTRATION_ENABLED=true
