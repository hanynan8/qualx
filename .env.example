# ───────────── مطلوب ─────────────
# رابط MongoDB (Atlas مثلًا). نفس المتغير بيستخدمه الموقع والداشبورد والسكريبتات.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/merilex?retryWrites=true&w=majority

# سر توقيع الجلسات: openssl rand -base64 32
NEXTAUTH_SECRET=

# دومين الموقع الفعلي (على Vercel لازم يتظبط في Production)
NEXTAUTH_URL=https://www.merilex.online

# ───────────── اختياري ─────────────
# Rate limiting موزّع (من غيره بيشتغل في ذاكرة السيرفر بس)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# رفع السير الذاتية (Vercel Blob) — CV_BLOB_ACCESS = public | private
BLOB_READ_WRITE_TOKEN=
CV_BLOB_ACCESS=

# false = قفل التسجيل الجديد لو اتعمل سبام
REGISTRATION_ENABLED=true

# للتطوير المحلي بس (مستحيل يشتغل في production): false = إيقاف تخطّي تسجيل الدخول
# ADMIN_AUTH_DISABLED=false

# بوابة الكارير: حدود الـ rate limit لكل IP (اختياري). ارفعها لو الناس داخلة من نفس الشبكة (عرض/تجربة جماعية).
# CAREER_REGISTER_LIMIT=5      # تسجيلات جديدة / ساعة
# CAREER_LOGIN_IP_LIMIT=10     # محاولات لوجن / 15 دقيقة
# CAREER_REGISTRATION_ENABLED=true   # false = قفل التسجيل الجديد في الكارير

# الإيميلات (Resend) — اختياري. من غيرهم الإشعارات بتتعطّل بهدوء.
# EMAIL_FROM لازم على دومين متحقق منه في Resend.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM="Merilex <no-reply@merilex.online>"
